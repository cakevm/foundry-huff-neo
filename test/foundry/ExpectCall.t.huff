// Ported from Foundry's testdata/default/cheats/ExpectCall.t.sol (Foundry v1.8.6, MIT OR Apache-2.0)
// Skipped: testExpectCallCountWithValueAndMinGas, testExpectCallCountWithNoValueAndMinGas and
// testExpectCallZeroCountWithNoValueAndWrongMinGas, as src/vm.huff has no macro for
// expectCallMinGas(address,uint256,uint64,bytes,uint64). testExpectCallAndDelegateCallForSameCalldata
// is covered by the two delegatecall tests. Foundry checks that a missing call fails the test in its
// Rust tests, which hnc cannot express: a test failed by an unmet expectCall does not match
// `expect_revert`.
// The `this.exposed_*` indirections of the Solidity tests are inlined, as expectCall covers every
// call until the end of the test.

#include "../../src/test.huff"

#define function numberA() pure returns (uint256)
#define function numberB() pure returns (uint256)
#define function add(uint256, uint256) pure returns (uint256)
#define function pay(uint256) payable returns (uint256)
#define function sum() view returns (uint256)
#define function sumDelegate() nonpayable returns (uint256)
#define function forwardPay() payable returns (uint256)
#define function addHardGasLimit() view returns (uint256)
#define function sumInPlace(uint256, uint256) view returns (uint256)

// `Contract` from fixtures/MockCallTarget.huff, etched at 0x1000
#define constant TARGET = 0x1000
// `NestedContract` and `ProxyWithDelegateCall` from fixtures/MockCallNested.huff, etched at 0x2000,
// calling the contract at 0x1000
#define constant NESTED = 0x2000

/* ── Helpers ── */

/// Pushes the length and the words of abi.encodeWithSelector(add.selector, 1, 2), length on top
#define macro ADD_1_2_DATA() = takes(0) returns(4) {
    0x02 0xe0 shl 0x01 0xe0 shl __FUNC_SIG(add) 0xe0 shl 0x44
}

/// Pushes the length and the words of abi.encodeWithSelector(add.selector, 1, 1), length on top
#define macro ADD_1_1_DATA() = takes(0) returns(4) {
    0x01 0xe0 shl 0x01 0xe0 shl __FUNC_SIG(add) 0xe0 shl 0x44
}

/// Pushes the length and the words of abi.encodeWithSelector(pay.selector, amount), length on top
#define macro PAY_DATA(amount) = takes(0) returns(3) {
    <amount> 0xe0 shl __FUNC_SIG(pay) 0xe0 shl 0x24
}

/// Consumes [a, b] and calls TARGET.add(a, b)
#define macro CALL_ADD() = takes(2) returns(0) {
    __FUNC_SIG(add) [TARGET] CALL_FUNCTION(0x02) ASSERT_TRUE()
}

/// Consumes [value, amount] and calls TARGET.pay{value: value}(amount)
#define macro CALL_PAY() = takes(2) returns(0) {
    [TARGET] __FUNC_SIG(pay)            // [selector, address, value, amount]
    swap2 swap1                         // [address, value, selector, amount]
    CALL_FUNCTION_WITH_VALUE(0x01) ASSERT_TRUE()
}

/// Calls NESTED.forwardPay{value: 1}(), which calls TARGET.pay{gas: 50_000, value: 1}(1)
#define macro CALL_FORWARD_PAY() = takes(0) returns(0) {
    __FUNC_SIG(forwardPay) 0x01 [NESTED] CALL_FUNCTION_WITH_VALUE(0x00) ASSERT_TRUE()
}

/// Calls NESTED.addHardGasLimit(), which calls TARGET.add{gas: 50_000}(1, 1)
#define macro CALL_ADD_HARD_GAS_LIMIT() = takes(0) returns(0) {
    __FUNC_SIG(addHardGasLimit) [NESTED] CALL_FUNCTION(0x00) ASSERT_TRUE()
}

/* ── ExpectCallTest ── */

#[etch(0x1000, "0x5f3560e01c8063994b9d571461003f5780633fc7c69814610048578063771602f714610051578063c290d6911461005f578063c41d478814610069575f5ffd5b60015f5260205ff35b60025f5260205ff35b602435600435015f5260205ff35b6004355f5260205ff35b5f546001015f5500")]
#define test EXPECT_CALL_WITH_DATA() = {
    // vm.expectCall(target, abi.encodeWithSelector(add, 1, 2))
    ADD_1_2_DATA() 0x40 [TARGET] VM_EXPECT_CALL(0x06, 0x00)
    0x02 0x01 CALL_ADD()
}

