    __FUNC_SIG(add) 0xe0 shl 0x04 0x40 [TARGET] VM_EXPECT_CALL(0x04, 0x00)
    // vm.expectCall(target, abi.encodeWithSelector(add, 1, 2), 2)
    ADD_1_2_DATA() 0x02 0x60 [TARGET] VM_EXPECT_CALL_ADDRESS_BYTES_UINT64(0x07, 0x00)
    0x02 0x01 CALL_ADD()
    0x02 0x01 CALL_ADD()
}
