    ADD_1_2_DATA() 0x40 [TARGET] VM_EXPECT_CALL(0x06, 0x00)
    // Even though we expect one call, more than one call is okay
    0x02 0x01 CALL_ADD()
    0x02 0x01 CALL_ADD()
}

