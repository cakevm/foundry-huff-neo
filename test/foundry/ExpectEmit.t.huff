#[etch(0x1000, "")]
#define test CAN_DO_STATIC_CALL() = {
    0x01 0x01 0x01 0x01 VM_EXPECT_EMIT_BOOL_BOOL_BOOL_BOOL(0x00)
    // emit Something(emitter.getVar(), 2, 3, 4)
    __FUNC_SIG("getVar()") 0x1000 STATICCALL_FUNCTION(0x00)
    0x04 0x00 mstore
    0x03 0x02 dup3 __EVENT_HASH(Something) 0x20 0x00 log4
    pop
    CALL_EMIT_EVENT(0x01, 0x02, 0x03, 0x04) ASSERT_TRUE()
}

// As long as the expected event is matched in order, the events emitted after it do not matter.
