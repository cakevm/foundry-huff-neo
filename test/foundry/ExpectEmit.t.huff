    0x1000 0x01 0x01 0x01 0x01 VM_EXPECT_EMIT_BOOL_BOOL_BOOL_BOOL_ADDRESS(0x00)
    EMIT_SOMETHING(0x01, 0x02, 0x03, 0x04)
    CALL_EMIT_MULTIPLE() ASSERT_TRUE()
}

/// Expects an event with one indexed topic, checking topic1 and the data, as
/// vm.expectEmit(true, false, false, true) and then emitting it
#define macro EXPECT_INDEXED(eventHash, topic1) = takes(0) returns(0) {
    0x01 0x00 0x00 0x01 VM_EXPECT_EMIT_BOOL_BOOL_BOOL_BOOL(0x00)
    EMIT_INDEXED(<eventHash>, <topic1>)
}

// emitWindow() emits events A, B, C, D, E.
#[etch(0x1000, "")]
#define test CAN_MATCH_CONSECUTIVE_EVENTS() = {
    EXPECT_INDEXED(__EVENT_HASH(A), 0x01)
    EXPECT_INDEXED(__EVENT_HASH(B), 0x02)
    EXPECT_INDEXED(__EVENT_HASH(C), 0x03)
    EXPECT_INDEXED(__EVENT_HASH(D), 0x04)
    EXPECT_INDEXED(__EVENT_HASH(E), 0x05)
    CALL_EMITTER(__FUNC_SIG("emitWindow()")) ASSERT_TRUE()
}

// [A, C, E] are in the right order, even if they are not consecutive.
#[etch(0x1000, "")]
#define test CAN_MATCH_CONSECUTIVE_EVENTS_SKIPPED() = {
    EXPECT_INDEXED(__EVENT_HASH(A), 0x01)
    EXPECT_INDEXED(__EVENT_HASH(C), 0x03)
    EXPECT_INDEXED(__EVENT_HASH(E), 0x05)
    CALL_EMITTER(__FUNC_SIG("emitWindow()")) ASSERT_TRUE()
}

#[etch(0x1000, "")]
