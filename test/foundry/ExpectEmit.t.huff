/* ── Calls that do not emit as expected ── */

#[etch(0x1000, "")]
#define test EXPECT_EMIT_FAILS_ON_OTHER_DATA() = {
    VM_EXPECT_EMIT(0x00)
    EMIT_SOMETHING(0x01, 0x02, 0x03, 0x04)
    CALL_EMIT_EVENT(0x01, 0x02, 0x03, 0x05)
    ASSERT_EMIT_ERROR(0xac, __RIGHTPAD(__BYTES("log mismatch at param 3: expecte")))
    // The expectation stays active after the failed call, so a later call can still meet it
    CALL_EMIT_EVENT(0x01, 0x02, 0x03, 0x04) ASSERT_TRUE()
}

#[etch(0x1000, "")]
#define test EXPECT_EMIT_FAILS_ON_OTHER_TOPIC() = {
    // topic2 is checked; data is not
    0x00 0x00 0x01 0x00 VM_EXPECT_EMIT_BOOL_BOOL_BOOL_BOOL(0x00)
    EMIT_SOMETHING(0x01, 0x02, 0x03, 0x04)
    CALL_EMIT_EVENT(0x01, 0x07, 0x03, 0x04)
    ASSERT_EMIT_ERROR(0xac, __RIGHTPAD(__BYTES("log mismatch at param 1: expecte")))
    // The expectation stays active after the failed call, so a later call can still meet it
    CALL_EMIT_EVENT(0x01, 0x02, 0x03, 0x04) ASSERT_TRUE()
}

#[etch(0x1000, ""), etch(0x1001, "")]
#define test EXPECT_EMIT_FAILS_ON_OTHER_EMITTER() = {
    0x1001 VM_EXPECT_EMIT_ADDRESS(0x00)
    EMIT_SOMETHING(0x01, 0x02, 0x03, 0x04)
    CALL_EMIT_EVENT(0x01, 0x02, 0x03, 0x04)
    ASSERT_EMIT_ERROR(0x79, __RIGHTPAD(__BYTES("log emitter mismatch: expected=0")))
    // The expectation stays active after the failed call, so a later call can still meet it
    0x04 0x03 0x02 0x01 __FUNC_SIG("emitEvent(uint256,uint256,uint256,uint256)") 0x1001 CALL_FUNCTION(0x04)
    ASSERT_TRUE()
}

#[etch(0x1000, "")]
#define test EXPECT_EMIT_FAILS_WITHOUT_EMIT() = {
    VM_EXPECT_EMIT(0x00)
    EMIT_SOMETHING(0x01, 0x02, 0x03, 0x04)
    CALL_EMITTER(__FUNC_SIG("doesNothing()"))
    ASSERT_EMIT_ERROR(0x13, __RIGHTPAD(__BYTES("log != expected log")))
    // The expectation stays active after the failed call, so a later call can still meet it
    CALL_EMIT_EVENT(0x01, 0x02, 0x03, 0x04) ASSERT_TRUE()
}

// [E, A] is not in the order emitWindow() emits them
#[etch(0x1000, "")]
#define test EXPECT_EMIT_FAILS_OUT_OF_ORDER() = {
    EXPECT_INDEXED(__EVENT_HASH(E), 0x05)
    EXPECT_INDEXED(__EVENT_HASH(A), 0x01)
    CALL_EMITTER(__FUNC_SIG("emitWindow()"))
    ASSERT_EMIT_ERROR(0x13, __RIGHTPAD(__BYTES("log != expected log")))
    // The expectation stays active after the failed call, so a later call can still meet it
    CALL_EMITTER(__FUNC_SIG("emitSplitWindow()")) ASSERT_TRUE()  // [A..E, A..E] holds E, then A
}

// SomethingElse(uint256 indexed) here and SomethingElse(uint256) in the emitter share topic 0 but differ in
// their number of topics, so they do not match. 0x2000 emits SomethingElse(1) with the topic indexed.
#[etch(0x1000, "")]
#[etch(0x2000, "0x60017f33a4e014a779e1d8436c0adf7cb8508480620074421c8c612ab169064bc36ca65f5fa200")]
#define test EXPECT_EMIT_FAILS_ON_OTHER_NUMBER_OF_TOPICS() = {
    0x01 0x01 0x01 0x01 VM_EXPECT_EMIT_BOOL_BOOL_BOOL_BOOL(0x00)
    EMIT_INDEXED(__EVENT_HASH(SomethingElse), 0x01)
    0x01 __FUNC_SIG("emitSomethingElse(uint256)") 0x1000 CALL_FUNCTION(0x01)
    // Foundry starts the message with the event's name when it knows the signature, or with "log",
    // so only its end is checked: "...indexed topic count mismatch: expected 1, got 0"
    msize returndatasize 0x00 dup3 returndatacopy  // [p, success], the revert data at p
    swap1 ASSERT_FALSE()                           // [p]
    dup1 0x20 add mload                            // [length, p]
    swap1 0x20 add add mload                       // [last 32 bytes of the message]
    0x6f756e74206d69736d617463683a20657870656374656420312c20676f742030 ASSERT_EQ()                     // "ount mismatch: expected 1, got 0"
    // The expectation stays active after the failed call, so a later call can still meet it
    __FUNC_SIG("emitIndexed()") 0x2000 CALL_FUNCTION(0x00) ASSERT_TRUE()
}

#[etch(0x1000, "")]
#define test COUNT_FAILS_ON_FEWER_EMITS() = {
    0x02 VM_EXPECT_EMIT_UINT64(0x00)
    EMIT_SOMETHING(0x01, 0x02, 0x03, 0x04)
    CALL_EMIT_EVENT(0x01, 0x02, 0x03, 0x04)
    ASSERT_EMIT_ERROR(0x13, __RIGHTPAD(__BYTES("log != expected log")))
    // The expectation stays active after the failed call, so a later call can still meet it
    0x02 0x04 0x03 0x02 0x01
    __FUNC_SIG("emitNEvents(uint256,uint256,uint256,uint256,uint256)") 0x1000 CALL_FUNCTION(0x05)
    ASSERT_TRUE()
}
