// Ported from Foundry's testdata/default/cheats/ExpectEmit.t.sol (Foundry v1.8.6, MIT OR Apache-2.0)
// Skipped: nothing of the active tests; the fuzz tests testExpectEmit and testExpectEmitNested are ported with
// fixed inputs, and the commented-out testExpectEmitIsCheckedWhenCurrentCallTerminates stays out. The failure
// cases at the end are new: Foundry checks them in its Rust test suite, not in this file.
//
// The emitters at 0x1000 and 0x1001 are fixtures/ExpectEmitEmitter.huff, etched with its runtime bytecode
// (`hnc test/foundry/fixtures/ExpectEmitEmitter.huff -r`). A test announces an expected event by emitting
// it itself, as `emit Something(..)` does in Solidity, then makes the call. A call made with CALL_FUNCTION
// reports success when it emitted what was expected, and fails with the reason as an ABI-encoded string when
// it did not.

#include "../../src/test.huff"

#define event Something(uint256 indexed, uint256 indexed, uint256 indexed, uint256)
#define event SomethingElse(uint256 indexed)
#define event SomethingNonIndexed(uint256)
#define event A(uint256 indexed)
#define event B(uint256 indexed)
#define event C(uint256 indexed)
#define event D(uint256 indexed)
#define event E(uint256 indexed)

/* ── Helpers ── */

/// Emits Something(topic1, topic2, topic3, data)
#define macro EMIT_SOMETHING(topic1, topic2, topic3, data) = takes(0) returns(0) {
    <data> 0x00 mstore
    <topic3> <topic2> <topic1> __EVENT_HASH(Something) 0x20 0x00 log4
}

/// Emits an event with one indexed topic and no data, such as A(1)
#define macro EMIT_INDEXED(eventHash, topic1) = takes(0) returns(0) {
    <topic1> <eventHash> 0x00 0x00 log2
}

/// Calls emitter.emitEvent(topic1, topic2, topic3, data) and pushes the success flag
#define macro CALL_EMIT_EVENT(topic1, topic2, topic3, data) = takes(0) returns(1) {
    <data> <topic3> <topic2> <topic1>
    __FUNC_SIG("emitEvent(uint256,uint256,uint256,uint256)") 0x1000 CALL_FUNCTION(0x04)
}

/// Calls emitter.emitMultiple([1, 5], [2, 6], [3, 7], [4, 8]) and pushes the success flag
#define macro CALL_EMIT_MULTIPLE() = takes(0) returns(1) {
    0x08 0x04 0x07 0x03 0x06 0x02 0x05 0x01
    __FUNC_SIG("emitMultiple(uint256[2],uint256[2],uint256[2],uint256[2])") 0x1000 CALL_FUNCTION(0x08)
}

/// Calls the emitter with a selector and no arguments, and pushes the success flag
#define macro CALL_EMITTER(selector) = takes(0) returns(1) {
    <selector> 0x1000 CALL_FUNCTION(0x00)
}

/// Consumes [success] and fails the test unless the call failed the way an unmet vm.expectEmit makes it
/// fail: with the ABI-encoded message as revert data, without a selector. `message` is the first 32 bytes
/// of the message, right-padded.
#define macro ASSERT_EMIT_ERROR(length, message) = takes(1) returns(0) {
    msize                                    // [p, success]
    0x60 0x00 dup3 returndatacopy            // offset, length and the first word of the message
    dup1 0x40 add mload                      // [word, p, success]
    dup2 0x20 add mload                      // [length, word, p, success]
    swap2 mload                              // [offset, word, length, success]
    swap3 ASSERT_FALSE()                     // [word, length, offset]
    <message> ASSERT_EQ_BYTES32()            // [length, offset]
    <length> ASSERT_EQ()                     // [offset]
    0x20 ASSERT_EQ()
}

/* ── ExpectEmitTest ── */

// testExpectEmit with fixed inputs: the topics and data that are not checked are altered
#[etch(0x1000, "")]
#define test EXPECT_EMIT() = {
    // everything checked
    0x01 0x01 0x01 0x01 VM_EXPECT_EMIT_BOOL_BOOL_BOOL_BOOL(0x00)
    EMIT_SOMETHING(0x0a, 0x0b, 0x0c, 0x0d)
    CALL_EMIT_EVENT(0x0a, 0x0b, 0x0c, 0x0d) ASSERT_TRUE()

    // topic1 not checked
    0x01 0x01 0x01 0x00 VM_EXPECT_EMIT_BOOL_BOOL_BOOL_BOOL(0x00)
    EMIT_SOMETHING(0x0a, 0x0b, 0x0c, 0x0d)
    CALL_EMIT_EVENT(0x0b, 0x0b, 0x0c, 0x0d) ASSERT_TRUE()

    // topic2 and data not checked
    0x00 0x01 0x00 0x01 VM_EXPECT_EMIT_BOOL_BOOL_BOOL_BOOL(0x00)
    EMIT_SOMETHING(0x0a, 0x0b, 0x0c, 0x0d)
    CALL_EMIT_EVENT(0x0a, 0x0c, 0x0c, 0x0e) ASSERT_TRUE()

    // only the event signature checked
    0x00 0x00 0x00 0x00 VM_EXPECT_EMIT_BOOL_BOOL_BOOL_BOOL(0x00)
    EMIT_SOMETHING(0x0a, 0x0b, 0x0c, 0x0d)
    CALL_EMIT_EVENT(0x0b, 0x0c, 0x0d, 0x0e) ASSERT_TRUE()
}

#[etch(0x1000, ""), etch(0x1001, "")]
#define test EXPECT_EMIT_NESTED() = {
    0x01 0x01 0x01 0x01 VM_EXPECT_EMIT_BOOL_BOOL_BOOL_BOOL(0x00)
    EMIT_SOMETHING(0x0a, 0x0b, 0x0c, 0x0d)
    0x0d 0x0c 0x0b 0x0a 0x1001
    __FUNC_SIG("emitNested(address,uint256,uint256,uint256,uint256)") 0x1000 CALL_FUNCTION(0x05)
    ASSERT_TRUE()

    // topic3 not checked
    0x01 0x00 0x01 0x01 VM_EXPECT_EMIT_BOOL_BOOL_BOOL_BOOL(0x00)
    EMIT_SOMETHING(0x0a, 0x0b, 0x0c, 0x0d)
    0x0d 0x0d 0x0b 0x0a 0x1001
    __FUNC_SIG("emitNested(address,uint256,uint256,uint256,uint256)") 0x1000 CALL_FUNCTION(0x05)
    ASSERT_TRUE()
}

