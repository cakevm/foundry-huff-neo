}

// emitNestedWindow() emits A, C, E, then A, B, C, D, E in an external call.
#[etch(0x1000, "")]
#define test CAN_MATCH_CONSECUTIVE_NESTED_EVENTS() = {
    EXPECT_INDEXED(__EVENT_HASH(A), 0x01)
    EXPECT_INDEXED(__EVENT_HASH(C), 0x03)
    EXPECT_INDEXED(__EVENT_HASH(E), 0x05)
    EXPECT_INDEXED(__EVENT_HASH(A), 0x01)
    EXPECT_INDEXED(__EVENT_HASH(B), 0x02)
    EXPECT_INDEXED(__EVENT_HASH(C), 0x03)
    EXPECT_INDEXED(__EVENT_HASH(D), 0x04)
    EXPECT_INDEXED(__EVENT_HASH(E), 0x05)
    CALL_EMITTER(__FUNC_SIG("emitNestedWindow()")) ASSERT_TRUE()
}

// emitSplitWindow() emits [A, B, C, D, E] twice, in two external calls at the same depth.
#[etch(0x1000, "")]
#define test CAN_MATCH_CONSECUTIVE_SUBTREE_EVENTS() = {
    EXPECT_INDEXED(__EVENT_HASH(A), 0x01)
    EXPECT_INDEXED(__EVENT_HASH(A), 0x01)
    EXPECT_INDEXED(__EVENT_HASH(B), 0x02)
    EXPECT_INDEXED(__EVENT_HASH(C), 0x03)
    EXPECT_INDEXED(__EVENT_HASH(D), 0x04)
    EXPECT_INDEXED(__EVENT_HASH(E), 0x05)
    CALL_EMITTER(__FUNC_SIG("emitSplitWindow()")) ASSERT_TRUE()
}

#[etch(0x1000, "")]
#define test CAN_MATCH_REPEATED_EVENTS() = {
    EXPECT_INDEXED(__EVENT_HASH(A), 0x01)
    EXPECT_INDEXED(__EVENT_HASH(C), 0x03)
    EXPECT_INDEXED(__EVENT_HASH(E), 0x05)
    EXPECT_INDEXED(__EVENT_HASH(A), 0x01)
    EXPECT_INDEXED(__EVENT_HASH(C), 0x03)
    EXPECT_INDEXED(__EVENT_HASH(E), 0x05)
    CALL_EMITTER(__FUNC_SIG("emitNestedWindow()")) ASSERT_TRUE()
}

// emitWindowAndOnTest(this) emits [A, B, C, D, E] and then calls emitLocal() on the test, which emits
// [A]. The test is called again for that, with calldata, so it emits A(1) and stops.
#[etch(0x1000, "")]
#define test EMIT_WINDOW_AND_ON_TEST() = {
    calldatasize iszero run jumpi
    EMIT_INDEXED(__EVENT_HASH(A), 0x01)      // emitLocal()
    stop

    run:
    EXPECT_INDEXED(__EVENT_HASH(A), 0x01)
    EXPECT_INDEXED(__EVENT_HASH(A), 0x01)
    address __FUNC_SIG("emitWindowAndOnTest(address)") 0x1000 CALL_FUNCTION(0x01)
    ASSERT_TRUE()
}

