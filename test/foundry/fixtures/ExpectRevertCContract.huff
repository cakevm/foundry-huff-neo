#define function callAndRevert() pure returns ()
#define function createDContract() nonpayable returns ()
#define function doNotRevert() nonpayable returns ()

#define error CContractError(string)

// The creation bytecode of ExpectRevertDContract.huff
#define table DCONTRACT_INITCODE {
    0x6308c379a05f52602060205260156040527f52657665727465642062792044436f6e747261637400000000000000000000006060526064601cfd60008060433d393df3
}

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload 0xe0 shr
    dup1 __FUNC_SIG(callAndRevert) eq call_and_revert jumpi
    dup1 __FUNC_SIG(createDContract) eq create_d_contract jumpi
    dup1 __FUNC_SIG(doNotRevert) eq do_not_revert jumpi
    0x00 0x00 revert

    call_and_revert:
        // CContractError("Reverted by CContract")
        __ERROR(CContractError) 0xe0 shr 0x00 mstore
        0x20 0x20 mstore
        0x15 0x40 mstore
        __RIGHTPAD(__BYTES("Reverted by CContract")) 0x60 mstore
        0x64 0x1c revert

    create_d_contract:
        __tablesize(DCONTRACT_INITCODE) __tablestart(DCONTRACT_INITCODE) 0x00 codecopy
        __tablesize(DCONTRACT_INITCODE) 0x00 0x00 create
        created jumpi
        returndatasize 0x00 0x00 returndatacopy
        returndatasize 0x00 revert
        created:
        stop

    do_not_revert:
        stop
}
