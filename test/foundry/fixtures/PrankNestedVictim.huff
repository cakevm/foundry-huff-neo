// Foundry's `NestedVictim` helper contract from Prank.t.sol, calling the PrankVictim.huff contract
// at 0x1000. Returns its own msg.sender and tx.origin, then those the inner victim saw.
// Runtime bytecode: hnc PrankNestedVictim.huff -r

#define constant INNER_VICTIM = 0x1000

#define macro MAIN() = takes(0) returns(0) {
    0x40 0x40 0x00 0x00 [INNER_VICTIM] gas staticcall
    ok jumpi
    returndatasize 0x00 0x00 returndatacopy
    returndatasize 0x00 revert
    ok:
    caller 0x00 mstore
    origin 0x20 mstore
    0x80 0x00 return
}
