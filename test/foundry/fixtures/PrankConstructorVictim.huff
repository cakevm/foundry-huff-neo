// Ported from Foundry's testdata (Foundry v1.8.6, MIT OR Apache-2.0)
// Foundry's `ConstructorVictim` helper contract from Prank.t.sol: the constructor stores the
// msg.sender and tx.origin it sees, and the runtime code returns the msg.sender and tx.origin of
// the call, then those the constructor saw.
// Creation bytecode: hnc PrankConstructorVictim.huff -b

#define macro CONSTRUCTOR() = takes(0) returns(0) {
    caller 0x00 sstore
    origin 0x01 sstore
}

#define macro MAIN() = takes(0) returns(0) {
    caller 0x00 mstore
    origin 0x20 mstore
    0x00 sload 0x40 mstore
    0x01 sload 0x60 mstore
    0x80 0x00 return
}
