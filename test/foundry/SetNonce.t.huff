// Ported from Foundry's testdata/default/cheats/SetNonce.t.sol (Foundry v1.8.6, MIT OR Apache-2.0)
// Skipped: none. testRevertIfInvalidNonce expects the revert of a cheatcode, which forge allows with
// allow_internal_expect_revert; hnc test fails a test whose cheatcode reverts, so it calls
// vm._expectCheatcodeRevert directly instead, as that is not in src/vm.huff.

#include "../../src/test.huff"

// 0x1000 is Foo: f() returns 1
//   6001 5f 52 6020 5f f3    return 1
#define constant FOO = 0x1000

#[etch(0x1000, "0x60015f5260205ff3")]
#define test SET_NONCE() = {
    0x0a [FOO] VM_SET_NONCE(0x00)                      // vm.setNonce(address(foo), 10)
    // makes sure working correctly after mutating nonce.
    __FUNC_SIG("f()") [FOO] STATICCALL_FUNCTION(0x00) pop
    0x0a [FOO] VM_GET_NONCE(0x00) ASSERT_EQ()          // assertEq(vm.getNonce(address(foo)), 10)
    __FUNC_SIG("f()") [FOO] STATICCALL_FUNCTION(0x00) pop
}

#[etch(0x1000, "0x60015f5260205ff3")]
#define test REVERT_IF_INVALID_NONCE() = {
    0x0a [FOO] VM_SET_NONCE(0x00)                      // vm.setNonce(address(foo), 10)

    // set lower nonce should fail: the message without the "vm.setNonce: " prefix, which the cheatcode adds
    0x6e7427732063757272656e74206e6f6e63652028313029000000000000000000
    0x7175616c20746f206f7220686967686572207468616e20746865206163636f75
    0x6e6577206e6f6e636520283529206d757374206265207374726963746c792065
    0x57 0x20 __FUNC_SIG("_expectCheatcodeRevert(bytes)") [VM_ADDRESS] CALL_FUNCTION(0x05) REQUIRE_SUCCESS()
    0x05 [FOO] VM_SET_NONCE(0x00)                      // vm.setNonce(address(foo), 5)
}
