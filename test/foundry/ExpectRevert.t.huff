/* ── ExpectRevertPrecompileTest ── */

#define test EXPECT_REVERT_DIRECT_PRECOMPILE_CALL() = {
    // BLAKE2F (0x09) expects exactly 213 bytes of input, so a call with one byte reverts
    VM_EXPECT_REVERT(0x00)
    0x00 0x00 0x01 0x00 0x00 0x09 gas call
    ASSERT_TRUE()
}

/* ── ExpectRevertWithErrorTest ── */

#[etch(0x1000, "")]
#define test F() = {
    // vm.expectRevert(abi.encodeWithSignature("Error(string)", "")) and revert with the same bytes
    0x00 0x20 0xe0 shl 0x08c379a0 0xe0 shl 0x44 0x20 VM_EXPECT_REVERT_BYTES(0x05, 0x00)
    0x00 0x20 0xe0 shl 0x08c379a0 0xe0 shl 0x44 0x20
    __FUNC_SIG("revertWithData(bytes)") 0x1000 CALL_FUNCTION(0x05)
    ASSERT_TRUE()
}

#[etch(0x1000, "")]
#define test EXPECT_REVERT_EXACT_MATCH_ANY_REVERT_DATA() = {
    // three bytes that are no error encoding
    0xabcdef 0xe8 shl 0x03 0x20 VM_EXPECT_REVERT_BYTES(0x03, 0x00)
    0xabcdef 0xe8 shl 0x03 0x20 __FUNC_SIG("revertWithData(bytes)") 0x1000 CALL_FUNCTION(0x03)
    ASSERT_TRUE()
}

#[etch(0x1000, "")]
#define test EXPECT_PARTIAL_REVERT_MATCHES_ANY_SUFFIX() = {
    0xdeadbeef VM_EXPECT_PARTIAL_REVERT(0x00)
    // abi.encodePacked(bytes4(0xdeadbeef), hex"0102")
    0xdeadbeef0102 0xd0 shl 0x06 0x20 __FUNC_SIG("revertWithData(bytes)") 0x1000 CALL_FUNCTION(0x03)
    ASSERT_TRUE()
}

// A bare-message expectation matches an Error(string) payload even when it carries trailing bytes.
#[etch(0x1000, "")]
#define test EXPECT_REVERT_ACTUAL_ERROR_STRING_WITH_TRAILING_DATA() = {
    __RIGHTPAD(__BYTES("reason")) 0x06 0x20 VM_EXPECT_REVERT_BYTES(0x03, 0x00)
    // abi.encodePacked(abi.encodeWithSignature("Error(string)", "reason"), uint256(2))
    0x02 0xe0 shl                            // the end of uint256(2)
    0x00                                     // the end of the padded message, then uint256(2)
    __RIGHTPAD(__BYTES("reason")) 0x20 shr 0x06 0xe0 shl or
    0x20 0xe0 shl
    0x08c379a0 0xe0 shl
    0x84 0x20
    __FUNC_SIG("revertWithData(bytes)") 0x1000 CALL_FUNCTION(0x07)
    ASSERT_TRUE()
}
