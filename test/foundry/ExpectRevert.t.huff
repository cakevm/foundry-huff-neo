    ASSERT_TRUE()
    REVERT_WITH_MESSAGE(0x1000, 0x07, __RIGHTPAD(__BYTES("revert2"))) CALL_FUNCTION(0x03)
    ASSERT_TRUE()
    REVERT_WITH_MESSAGE(0x1000, 0x07, __RIGHTPAD(__BYTES("revert3"))) CALL_FUNCTION(0x03)
    ASSERT_TRUE()

    __RIGHTPAD(__BYTES("revert")) 0x06 0x20 VM_EXPECT_REVERT_BYTES(0x03, 0x00)
    REVERT_WITH_MESSAGE(0x1000, 0x06, __RIGHTPAD(__BYTES("revert"))) CALL_FUNCTION(0x03)
    ASSERT_TRUE()
}

