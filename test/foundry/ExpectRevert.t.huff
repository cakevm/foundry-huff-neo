#[etch(0x1000, ""), etch(0x1001, "")]
#define test REVERT_COUNT_NESTED_SPECIFIC() = {
    __RIGHTPAD(__BYTES("nested revert")) 0x0d 0x02 0x40 VM_EXPECT_REVERT_BYTES_UINT64(0x04, 0x00)
    REVERT_WITH_MESSAGE(0x1000, 0x0d, __RIGHTPAD(__BYTES("nested revert"))) CALL_FUNCTION(0x03)
    ASSERT_TRUE()
    __RIGHTPAD(__BYTES("nested revert")) 0x0d 0x40 0x1001
    __FUNC_SIG("nestedRevert(address,string)") 0x1000 CALL_FUNCTION(0x04)
    ASSERT_TRUE()

    __RIGHTPAD(__BYTES("nested revert")) 0x0d 0x02 0x40 VM_EXPECT_REVERT_BYTES_UINT64(0x04, 0x00)
    __RIGHTPAD(__BYTES("nested revert")) 0x0d 0x40 0x1001
    __FUNC_SIG("nestedRevert(address,string)") 0x1000 CALL_FUNCTION(0x04)
    ASSERT_TRUE()
    __RIGHTPAD(__BYTES("nested revert")) 0x0d 0x40 0x1001
    __FUNC_SIG("nestedRevert(address,string)") 0x1000 CALL_FUNCTION(0x04)
    ASSERT_TRUE()
}

