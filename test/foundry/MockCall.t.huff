#define test MOCK_CALL_REVERT_WITH_VALUE() = {
    0x0a address VM_DEAL(0x00)

    // vm.mockCallRevert(mock, 10, abi.encodeWithSelector(pay), "ERROR_MESSAGE")
    __RIGHTPAD(__BYTES("ERROR_MESSAGE")) 0x0d __FUNC_SIG(pay) 0xe0 shl 0x04 0xc0 0x80 0x0a [TARGET]
