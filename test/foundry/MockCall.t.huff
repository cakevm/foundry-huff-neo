    0x01 0x00 PAY() 0x01 ASSERT_EQ()
    0x02 0x00 PAY() 0x02 ASSERT_EQ()

    0x01 __FUNC_SIG(pay) 0x0a [TARGET] CALL_FUNCTION_WITH_VALUE(0x01)
    ASSERT_REVERTED_WITH_ERROR_MESSAGE()

    selfbalance 0x0a ASSERT_EQ()
    [TARGET] balance 0x00 ASSERT_EQ()
}

