// Ported from Foundry's testdata/default/cheats/MockCall.t.sol (Foundry v1.8.6, MIT OR Apache-2.0)
// Skipped: testMockCallNoCodeInjectionNoReturnValue, as it checks Solidity's `extcodesize` check
// before a call, which raw Huff calls do not make. testMockCallEmptyAccountNoCodeInjection checks the
// plain EVM behaviour instead: an unmocked call to the codeless account succeeds without data.
// The loop of 100 mocks in testMockCallWithValue is reduced to the three values it checks.

#include "../../src/test.huff"

#define function numberA() pure returns (uint256)
#define function numberB() pure returns (uint256)
#define function add(uint256, uint256) pure returns (uint256)
#define function pay(uint256) payable returns (uint256)
#define function noReturnValue() nonpayable returns ()
#define function sum() view returns (uint256)
#define function sumDelegate() nonpayable returns (uint256)

#define error TestError(bytes)

// `Mock` from fixtures/MockCallTarget.huff, etched at 0x1000
#define constant TARGET = 0x1000
// `NestedMock` and `NestedMockDelegateCall` from fixtures/MockCallNested.huff, etched at 0x2000
#define constant NESTED = 0x2000
// An account without code
#define constant EMPTY = 0x64

/* ── Helpers ── */

/// Consumes [address, selector] and pushes the word the call returns
#define macro GET() = takes(2) returns(1) {
    STATICCALL_FUNCTION(0x00)
}

/// Consumes [a, b] and pushes TARGET.add(a, b)
#define macro ADD() = takes(2) returns(1) {
    __FUNC_SIG(add) [TARGET] STATICCALL_FUNCTION(0x02)
}

/// Consumes [value, amount], calls TARGET.pay{value: value}(amount) and pushes the word it returns
#define macro PAY() = takes(2) returns(1) {
    [TARGET] __FUNC_SIG(pay)            // [selector, address, value, amount]
    swap2 swap1                         // [address, value, selector, amount]
    CALL_FUNCTION_WITH_VALUE(0x01)      // [success]
    LAST_RETURN_WORD() swap1 ASSERT_TRUE()
}

/// Consumes [success] and fails the test unless the last call reverted with "ERROR_MESSAGE"
#define macro ASSERT_REVERTED_WITH_ERROR_MESSAGE() = takes(1) returns(0) {
    LAST_RETURN_WORD() returndatasize  // [size, word, success]
    0x0d ASSERT_EQ()
    __RIGHTPAD(__BYTES("ERROR_MESSAGE")) ASSERT_EQ_BYTES32()
    ASSERT_FALSE()
}

/// Pushes the 4 words of abi.encodeWithSelector(TestError.selector, "ERROR_MESSAGE"), first on top
#define macro CUSTOM_ERROR_WORDS() = takes(0) returns(4) {
    0x00                                                            // the end of the message
    __RIGHTPAD(__BYTES("ERROR_MESSAGE")) 0x20 shr 0x0d 0xe0 shl or  // length, message
    0x20 0xe0 shl                                                   // offset
    __ERROR(TestError)                                              // selector
}

/// Consumes [success] and fails the test unless the last call reverted with the custom error
#define macro ASSERT_REVERTED_WITH_CUSTOM_ERROR() = takes(1) returns(0) {
    returndatasize 0x00 0x200 returndatacopy
    returndatasize 0x200 sha3           // [hash(returned), success]
    CUSTOM_ERROR_WORDS()
    0x400 mstore 0x420 mstore 0x440 mstore 0x460 mstore
    0x64 0x400 sha3                     // [hash(expected), hash(returned), success]
    ASSERT_EQ_BYTES32()
    ASSERT_FALSE()
}

