#[etch(0x1000, "0x5f3560e01c8063994b9d571461003f5780633fc7c69814610048578063771602f714610051578063c290d6911461005f578063c41d478814610069575f5ffd5b60015f5260205ff35b60025f5260205ff35b602435600435015f5260205ff35b6004355f5260205ff35b5f546001015f5500")]
#define test MOCK_CALL_WITH_VALUE() = {
    // vm.mockCall(mock, 10, abi.encodeWithSelector(pay), abi.encode(10))
    0x0a 0x20 __FUNC_SIG(pay) 0xe0 shl 0x04 0xc0 0x80 0x0a [TARGET]
    VM_MOCK_CALL_ADDRESS_UINT256_BYTES_BYTES(0x08, 0x00)

    0x01 0x0a PAY() 0x0a ASSERT_EQ()   // mock.pay{value: 10}(1)
    0x01 0x00 PAY() 0x01 ASSERT_EQ()   // mock.pay(1)

    // vm.mockCall(mock, i, abi.encodeWithSelector(pay), abi.encode(i * 2)) for i = 0, 10, 50
    0x00 0x20 __FUNC_SIG(pay) 0xe0 shl 0x04 0xc0 0x80 0x00 [TARGET]
    VM_MOCK_CALL_ADDRESS_UINT256_BYTES_BYTES(0x08, 0x00)
    0x14 0x20 __FUNC_SIG(pay) 0xe0 shl 0x04 0xc0 0x80 0x0a [TARGET]
    VM_MOCK_CALL_ADDRESS_UINT256_BYTES_BYTES(0x08, 0x00)
    0x64 0x20 __FUNC_SIG(pay) 0xe0 shl 0x04 0xc0 0x80 0x32 [TARGET]
    VM_MOCK_CALL_ADDRESS_UINT256_BYTES_BYTES(0x08, 0x00)

    0x01 0x00 PAY() 0x00 ASSERT_EQ()
    0x01 0x0a PAY() 0x14 ASSERT_EQ()
    0x01 0x32 PAY() 0x64 ASSERT_EQ()
}

