#define test MOCK_CALL_EMPTY_ACCOUNT() = {
    // vm.mockCall(mock, abi.encodeWithSelector(add), abi.encode(10))
    0x0a 0x20 __FUNC_SIG(add) 0xe0 shl 0x04 0xa0 0x60 [EMPTY]
    VM_MOCK_CALL(0x07, 0x00)
    // vm.mockCall(mock, noReturnValue.selector, abi.encode())
    0x00 0x60 __FUNC_SIG(noReturnValue) 0xe0 shl [EMPTY]
    VM_MOCK_CALL_ADDRESS_BYTES4_BYTES(0x04, 0x00)

    0x02 0x01 __FUNC_SIG(add) [EMPTY] STATICCALL_FUNCTION(0x02) 0x0a ASSERT_EQ()
    __FUNC_SIG(noReturnValue) [EMPTY] CALL_FUNCTION(0x00) ASSERT_TRUE()
    [EMPTY] extcodesize 0x01 ASSERT_EQ()    // code was injected into the empty account
}

#define test MOCK_CALL_EMPTY_ACCOUNT_NO_CODE_INJECTION() = {
    // vm.mockCall(mock, abi.encodeWithSelector(add), abi.encode(10), false)
    0x0a 0x20 __FUNC_SIG(add) 0xe0 shl 0x04 0x00 0xc0 0x80 [EMPTY]
    VM_MOCK_CALL_ADDRESS_BYTES_BYTES_BOOL(0x08, 0x00)

    // Mocked calls that return data succeed while the account remains codeless
    0x02 0x01 __FUNC_SIG(add) [EMPTY] STATICCALL_FUNCTION(0x02) 0x0a ASSERT_EQ()
    [EMPTY] extcodesize 0x00 ASSERT_EQ()

    // An unmocked call to the empty account returns no data
    __FUNC_SIG(numberA) [EMPTY] CALL_FUNCTION(0x00)
    returndatasize 0x00 ASSERT_EQ()
    ASSERT_TRUE()
}

#define test MOCK_CALL_EMPTY_ACCOUNT_INJECT_CODE() = {
    // vm.mockCall(mock, abi.encodeWithSelector(add), abi.encode(10), true)
    0x0a 0x20 __FUNC_SIG(add) 0xe0 shl 0x04 0x01 0xc0 0x80 [EMPTY]
    VM_MOCK_CALL_ADDRESS_BYTES_BYTES_BOOL(0x08, 0x00)
    // vm.mockCall(mock, abi.encodeWithSelector(noReturnValue), abi.encode(), true)
    0x00 __FUNC_SIG(noReturnValue) 0xe0 shl 0x04 0x01 0xc0 0x80 [EMPTY]
    VM_MOCK_CALL_ADDRESS_BYTES_BYTES_BOOL(0x07, 0x00)

    0x02 0x01 __FUNC_SIG(add) [EMPTY] STATICCALL_FUNCTION(0x02) 0x0a ASSERT_EQ()
    __FUNC_SIG(noReturnValue) [EMPTY] CALL_FUNCTION(0x00) ASSERT_TRUE()
    [EMPTY] extcodesize 0x01 ASSERT_EQ()
}

