#[etch(0x1000, "0x5f3560e01c8063994b9d571461003f5780633fc7c69814610048578063771602f714610051578063c290d6911461005f578063c41d478814610069575f5ffd5b60015f5260205ff35b60025f5260205ff35b602435600435015f5260205ff35b6004355f5260205ff35b5f546001015f5500")]
#define test MOCK_CALLDATA() = {
    0x05 0x05 ADD() 0x0a ASSERT_EQ()
    0x04 0x06 ADD() 0x0a ASSERT_EQ()

    // vm.mockCall(target, abi.encodeWithSelector(add, 5, 5), abi.encode(11)): the calldata words are
    // the selector, then the two arguments shifted by the 4 bytes of the selector
    0x0b 0x20                                        // return data: length, word
    0x05 0xe0 shl 0x05 0xe0 shl __FUNC_SIG(add) 0xe0 shl 0x44
    0xe0 0x60 [TARGET]
    VM_MOCK_CALL(0x09, 0x00)

    0x05 0x05 ADD() 0x0b ASSERT_EQ()
    0x04 0x06 ADD() 0x0a ASSERT_EQ()
}

#[etch(0x1000, "0x5f3560e01c8063994b9d571461003f5780633fc7c69814610048578063771602f714610051578063c290d6911461005f578063c41d478814610069575f5ffd5b60015f5260205ff35b60025f5260205ff35b602435600435015f5260205ff35b6004355f5260205ff35b5f546001015f5500")]
