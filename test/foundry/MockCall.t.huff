#[etch(0x1000, "0x5f3560e01c8063994b9d571461003f5780633fc7c69814610048578063771602f714610051578063c290d6911461005f578063c41d478814610069575f5ffd5b60015f5260205ff35b60025f5260205ff35b602435600435015f5260205ff35b6004355f5260205ff35b5f546001015f5500")]
#define test MOCK_GETTERS() = {
    // pre-mock
    __FUNC_SIG(numberA) [TARGET] GET() 0x01 ASSERT_EQ()
    __FUNC_SIG(numberB) [TARGET] GET() 0x02 ASSERT_EQ()

    // vm.mockCall(target, abi.encodeWithSelector(numberB), abi.encode(10))
    0x0a 0x20 __FUNC_SIG(numberB) 0xe0 shl 0x04 0xa0 0x60 [TARGET]
    VM_MOCK_CALL(0x07, 0x00)

    // post-mock
    __FUNC_SIG(numberA) [TARGET] GET() 0x01 ASSERT_EQ()
    __FUNC_SIG(numberB) [TARGET] GET() 0x0a ASSERT_EQ()
}

#[etch(0x1000, "0x5f3560e01c8063994b9d571461003f5780633fc7c69814610048578063771602f714610051578063c290d6911461005f578063c41d478814610069575f5ffd5b60015f5260205ff35b60025f5260205ff35b602435600435015f5260205ff35b6004355f5260205ff35b5f546001015f5500")]
#[etch(0x2000, "")]
#define test MOCK_NESTED() = {
    // pre-mock
    __FUNC_SIG(sum) [NESTED] GET() 0x03 ASSERT_EQ()

    // vm.mockCall(inner, abi.encodeWithSelector(numberB), abi.encode(9))
    0x09 0x20 __FUNC_SIG(numberB) 0xe0 shl 0x04 0xa0 0x60 [TARGET]
    VM_MOCK_CALL(0x07, 0x00)

    // post-mock
    __FUNC_SIG(sum) [NESTED] GET() 0x0a ASSERT_EQ()
}

#[etch(0x1000, "0x5f3560e01c8063994b9d571461003f5780633fc7c69814610048578063771602f714610051578063c290d6911461005f578063c41d478814610069575f5ffd5b60015f5260205ff35b60025f5260205ff35b602435600435015f5260205ff35b6004355f5260205ff35b5f546001015f5500")]
#[etch(0x2000, "")]
#define test MOCK_NESTED_DELEGATE() = {
    __FUNC_SIG(sumDelegate) [NESTED] CALL_FUNCTION(0x00)
    LAST_RETURN_WORD() swap1 ASSERT_TRUE() 0x03 ASSERT_EQ()

    // vm.mockCall(inner, abi.encodeWithSelector(numberB), abi.encode(9)) also mocks delegatecalls
    0x09 0x20 __FUNC_SIG(numberB) 0xe0 shl 0x04 0xa0 0x60 [TARGET]
    VM_MOCK_CALL(0x07, 0x00)

    __FUNC_SIG(sumDelegate) [NESTED] CALL_FUNCTION(0x00)
    LAST_RETURN_WORD() swap1 ASSERT_TRUE() 0x0a ASSERT_EQ()
}

#[etch(0x1000, "0x5f3560e01c8063994b9d571461003f5780633fc7c69814610048578063771602f714610051578063c290d6911461005f578063c41d478814610069575f5ffd5b60015f5260205ff35b60025f5260205ff35b602435600435015f5260205ff35b6004355f5260205ff35b5f546001015f5500")]
