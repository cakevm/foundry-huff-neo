    __FUNC_SIG(numberB) [TARGET] GET() 0x02 ASSERT_EQ()

    // vm.mockCallRevert(target, numberB.selector, "ERROR_MESSAGE")
    __RIGHTPAD(__BYTES("ERROR_MESSAGE")) 0x0d 0x60 __FUNC_SIG(numberB) 0xe0 shl [TARGET]
    VM_MOCK_CALL_REVERT_ADDRESS_BYTES4_BYTES(0x05, 0x00)

    __FUNC_SIG(numberA) [TARGET] GET() 0x01 ASSERT_EQ()
    __FUNC_SIG(numberB) [TARGET] CALL_FUNCTION(0x00)
    ASSERT_REVERTED_WITH_ERROR_MESSAGE()
}

