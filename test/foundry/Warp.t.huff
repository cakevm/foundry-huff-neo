// Skipped: none. hnc test does not fuzz, so testWarpFuzzed runs with the largest uint32 jump.

#include "../../src/test.huff"

#define test WARP() = {
    0x0a VM_WARP(0x00)                                 // vm.warp(10)
    0x0a VM_GET_BLOCK_TIMESTAMP(0x00) ASSERT_EQ()      // assertEq(vm.getBlockTimestamp(), 10)
}

#define test WARP_FUZZED() = {
    VM_GET_BLOCK_TIMESTAMP(0x00)                       // [pre]
    0xffffffff VM_GET_BLOCK_TIMESTAMP(0x00) add        // [timestamp + jump, pre]
    VM_WARP(0x00)                                      // [pre]
    0xffffffff add                                     // [pre + jump]
    VM_GET_BLOCK_TIMESTAMP(0x00) ASSERT_EQ()
}

#define test WARP2() = {
    0x01 VM_GET_BLOCK_TIMESTAMP(0x00) ASSERT_EQ()      // assertEq(vm.getBlockTimestamp(), 1)
    0x64 VM_WARP(0x00)                                 // vm.warp(100)
    0x64 VM_GET_BLOCK_TIMESTAMP(0x00) ASSERT_EQ()
}
