#define test SNAPSHOT_STATE_REVERT_DELETE() = {
    VM_SNAPSHOT(0x00)                        // [snapshotId]
    WRITE_STORE()
    ASSERT_STORE_WRITTEN()

    dup1 VM_REVERT_TO_AND_DELETE(0x00) pop
    ASSERT_STORE_REVERTED()
    // nothing to revert to anymore
