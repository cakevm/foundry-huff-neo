#[store([SLOT0], 10), store([SLOT1], 20)]
#define test SNAPSHOT_STATE() = {
    VM_SNAPSHOT(0x00)                        // [snapshotId]
    WRITE_STORE()
    ASSERT_STORE_WRITTEN()

    VM_REVERT_TO(0x00) pop
    ASSERT_STORE_REVERTED()
}

