#define test SNAPSHOT_STATES_MANY() = {
    0x00                                     // [c]
    outer:
        0x00                                 // [cc, c]
        inner:
            VM_SNAPSHOT(0x00)                // [snapshotId, cc, c]
            dup1 VM_REVERT_TO_AND_DELETE(0x00) pop
            VM_REVERT_TO(0x00) ASSERT_FALSE()
            0x01 add                         // [cc + 1, c]
            dup1 0x0a gt inner jumpi
        pop
        0x01 add                             // [c + 1]
        dup1 0x0a gt outer jumpi
    pop
}

#define test DEPRECATED_BLOCK_VALUES() = {
    prevrandao timestamp number              // [num, time, prevrandao]

    VM_SNAPSHOT(0x00)                        // [snapshotId, num, time, prevrandao]

    0x0539 VM_WARP(0x00)
    0x0539 timestamp ASSERT_EQ()

    0x63 VM_ROLL(0x00)
    0x63 number ASSERT_EQ()

    0x7b VM_PREVRANDAO_UINT256(0x00)
    0x7b prevrandao ASSERT_EQ()

    VM_REVERT_TO(0x00) ASSERT_TRUE()         // [num, time, prevrandao]

    number ASSERT_EQ()
    timestamp ASSERT_EQ()
    prevrandao ASSERT_EQ()
}
