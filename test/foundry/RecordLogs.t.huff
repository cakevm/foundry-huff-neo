// Ported from Foundry's testdata/default/cheats/RecordLogs.t.sol (Foundry v1.8.6, MIT OR Apache-2.0)
// Skipped: NOtestRecordOnAnonymousEvent, which is disabled in the source; testRecordedLogsJson, as it
// passes the JSON string `vm.getRecordedLogsJson` returns on to `vm.parseJsonString` and
// `vm.parseJsonStringArray`, and the `VM_*` macros only take string arguments as words on the stack.
// `new Emitter()` is the runtime code of fixtures/RecordLogsEmitter.huff etched at EMITTER, and
// `new Emitterv2()` is fixtures/RecordLogsEmitterV2.huff at EMITTER_V2, with the Emitter it deploys
// etched at EMITTER_OF_V2 and stored in its slot 0. generateTestData(n) is precomputed: its bytes are
// SEED = keccak256("Some data"), and keccak256(SEED) once a call has used 32 bytes.

#include "../../src/test.huff"

#define event LogTopic(uint256 indexed, bytes)
#define event LogTopic0(bytes)
#define event LogTopic1(uint256 indexed, bytes)
#define event LogTopic12(uint256 indexed, uint256 indexed, bytes)
#define event LogTopic123(uint256 indexed, uint256 indexed, uint256 indexed, bytes)

#define constant EMITTER = 0x2000
#define constant EMITTER_OF_V2 = 0x2001
#define constant EMITTER_V2 = 0x3000

/* ── Test data ── */

/// generateTestData(32) or the first 32 bytes of generateTestData(48)
#define macro SEED() = takes(0) returns(1) {
    0x43a26051362b8040b289abe93334a5e3662751aa691185ae9e9a2e1e0c169350
}
/// The last 16 bytes of generateTestData(48), or generateTestData(16) after generateTestData(32)
#define macro SEED2_16() = takes(0) returns(1) {
    __RIGHTPAD(0x2e38edeff9493e0004540e975027a429)
}
/// generateTestData(16), (20) and (24) as a first call
#define macro SEED_16() = takes(0) returns(1) { __RIGHTPAD(0x43a26051362b8040b289abe93334a5e3) }
#define macro SEED_20() = takes(0) returns(1) { __RIGHTPAD(0x43a26051362b8040b289abe93334a5e3662751aa) }
#define macro SEED_24() = takes(0) returns(1) { __RIGHTPAD(0x43a26051362b8040b289abe93334a5e3662751aa691185ae) }
/// generateTestData(24) once the first 32 bytes are used up
#define macro SEED2_24() = takes(0) returns(1) {
    __RIGHTPAD(0x2e38edeff9493e0004540e975027a429ee666d1289f2c7a4)
}

/* ── Reading vm.getRecordedLogs ── */
// The Log[] is at 0x00: its offset, its length at 0x20, then the offsets of the entries from 0x40.
// Each entry holds the offsets of its topics and data, then its emitter.

/// Pushes a pointer to entry i
#define macro ENTRY(i) = takes(0) returns(1) {
    <i> 0x20 mul 0x40 add mload 0x40 add
}

/// Pushes entries[i].topics.length
#define macro TOPICS_LENGTH(i) = takes(0) returns(1) {
    ENTRY(<i>) dup1 mload add mload
}

/// Pushes entries[i].topics[j]
#define macro TOPIC(i, j) = takes(0) returns(1) {
    ENTRY(<i>) dup1 mload add <j> 0x01 add 0x20 mul add mload
}

/// Pushes entries[i].emitter
#define macro EMITTER_OF(i) = takes(0) returns(1) {
    ENTRY(<i>) 0x40 add mload
}

/// Pushes word j of abi.decode(entries[i].data, (string)), the data being abi.encode(bytes)
#define macro DATA_WORD(i, j) = takes(0) returns(1) {
    ENTRY(<i>) dup1 0x20 add mload add <j> 0x03 add 0x20 mul add mload
}

/// Checks that abi.decode(entries[i].data, (string)) has `length` bytes
#define macro ASSERT_DATA_LENGTH(i, length) = takes(0) returns(0) {
    <length> ENTRY(<i>) dup1 0x20 add mload add 0x40 add mload ASSERT_EQ()
}

#[etch(0x2000, "")]
#define test RECORD_OFF_GETS_NOTHING() = {
    // emitter.emitEvent(1, 2, 3, generateTestData(48))
    SEED2_16() SEED() 0x30 0x80 0x03 0x02 0x01
    __FUNC_SIG("emitEvent(uint256,uint256,uint256,bytes)") [EMITTER] CALL_FUNCTION(0x07) ASSERT_TRUE()
    VM_GET_RECORDED_LOGS(0x00) pop

    0x00 0x20 mload ASSERT_EQ()
}

#define test RECORD_ON_NO_LOGS() = {
    VM_RECORD_LOGS(0x00)
    VM_GET_RECORDED_LOGS(0x00) pop

    0x00 0x20 mload ASSERT_EQ()
}

#[etch(0x2000, "")]
#define test RECORD_ON_SINGLE_LOG() = {
    VM_RECORD_LOGS(0x00)
    // emitter.emitEvent(1, 2, 3, "Event Data in String")
    __RIGHTPAD(__BYTES("Event Data in String")) 0x14 0x80 0x03 0x02 0x01
    __FUNC_SIG("emitEvent(uint256,uint256,uint256,bytes)") [EMITTER] CALL_FUNCTION(0x06) ASSERT_TRUE()
    VM_GET_RECORDED_LOGS(0x00) pop

    0x01 0x20 mload ASSERT_EQ()
    0x04 TOPICS_LENGTH(0x00) ASSERT_EQ()
    __EVENT_HASH(LogTopic123) TOPIC(0x00, 0x00) ASSERT_EQ_BYTES32()
    0x01 TOPIC(0x00, 0x01) ASSERT_EQ_BYTES32()
    0x02 TOPIC(0x00, 0x02) ASSERT_EQ_BYTES32()
    0x03 TOPIC(0x00, 0x03) ASSERT_EQ_BYTES32()
    ASSERT_DATA_LENGTH(0x00, 0x14)
    __RIGHTPAD(__BYTES("Event Data in String")) DATA_WORD(0x00, 0x00) ASSERT_EQ_BYTES32()
    [EMITTER] EMITTER_OF(0x00) ASSERT_EQ_ADDRESS()
}

#[etch(0x2000, "")]
#define test RECORD_ON_SINGLE_LOG_TOPIC0() = {
    VM_RECORD_LOGS(0x00)
    // emitter.emitEvent(generateTestData(48))
    SEED2_16() SEED() 0x30 0x20
    __FUNC_SIG("emitEvent(bytes)") [EMITTER] CALL_FUNCTION(0x04) ASSERT_TRUE()
    VM_GET_RECORDED_LOGS(0x00) pop

    0x01 0x20 mload ASSERT_EQ()
    0x01 TOPICS_LENGTH(0x00) ASSERT_EQ()
    __EVENT_HASH(LogTopic0) TOPIC(0x00, 0x00) ASSERT_EQ_BYTES32()
    ASSERT_DATA_LENGTH(0x00, 0x30)
    SEED() DATA_WORD(0x00, 0x00) ASSERT_EQ_BYTES32()
    SEED2_16() DATA_WORD(0x00, 0x01) ASSERT_EQ_BYTES32()
    [EMITTER] EMITTER_OF(0x00) ASSERT_EQ_ADDRESS()
}

#[etch(0x2000, "")]
#define test EMIT_RECORD_EMIT() = {
    // emitter.emitEvent(1, 2, generateTestData(32))
    SEED() 0x20 0x60 0x02 0x01
    __FUNC_SIG("emitEvent(uint256,uint256,bytes)") [EMITTER] CALL_FUNCTION(0x05) ASSERT_TRUE()

    VM_RECORD_LOGS(0x00)
    // emitter.emitEvent(3, generateTestData(16))
    SEED2_16() 0x10 0x40 0x03
    __FUNC_SIG("emitEvent(uint256,bytes)") [EMITTER] CALL_FUNCTION(0x04) ASSERT_TRUE()
    VM_GET_RECORDED_LOGS(0x00) pop

    0x01 0x20 mload ASSERT_EQ()
    0x02 TOPICS_LENGTH(0x00) ASSERT_EQ()
    __EVENT_HASH(LogTopic1) TOPIC(0x00, 0x00) ASSERT_EQ_BYTES32()
    0x03 TOPIC(0x00, 0x01) ASSERT_EQ_BYTES32()
    ASSERT_DATA_LENGTH(0x00, 0x10)
    SEED2_16() DATA_WORD(0x00, 0x00) ASSERT_EQ_BYTES32()
    [EMITTER] EMITTER_OF(0x00) ASSERT_EQ_ADDRESS()
}

// Emitter at EMITTER and at EMITTER_OF_V2, Emitterv2 at EMITTER_V2
#[etch(0x2000, "")]
#[etch(0x2001, "")]
#[etch(0x3000, "0x5f3560e01c806307f287d51461001e5780631377f06e14610032575f5ffd5b365f5f375f5f365f5f5f545af11561003b57005b5f545f5260205ff35b5f5ffd")]
#[store(0, 0x2001, at = 0x3000)]
#define test RECORD_ON_EMIT_DIFFERENT_DEPTHS() = {
    VM_RECORD_LOGS(0x00)

    // emit LogTopic(1, generateTestData(16))
    0x20 0x00 mstore 0x10 0x20 mstore SEED_16() 0x40 mstore
    0x01 __EVENT_HASH(LogTopic) 0x60 0x00 log2

    // emitter.emitEvent(2, 3, generateTestData(20))
    SEED_20() 0x14 0x60 0x03 0x02
    __FUNC_SIG("emitEvent(uint256,uint256,bytes)") [EMITTER] CALL_FUNCTION(0x05) ASSERT_TRUE()

    // emitter2.emitEvent(4, 5, 6, generateTestData(24))
    SEED_24() 0x18 0x80 0x06 0x05 0x04
    __FUNC_SIG("emitEvent(uint256,uint256,uint256,bytes)") [EMITTER_V2] CALL_FUNCTION(0x06) ASSERT_TRUE()

    VM_GET_RECORDED_LOGS(0x00) pop

    0x03 0x20 mload ASSERT_EQ()

    0x02 TOPICS_LENGTH(0x00) ASSERT_EQ()
    __EVENT_HASH(LogTopic) TOPIC(0x00, 0x00) ASSERT_EQ_BYTES32()
    0x01 TOPIC(0x00, 0x01) ASSERT_EQ_BYTES32()
    ASSERT_DATA_LENGTH(0x00, 0x10)
    SEED_16() DATA_WORD(0x00, 0x00) ASSERT_EQ_BYTES32()
    address EMITTER_OF(0x00) ASSERT_EQ_ADDRESS()

    0x03 TOPICS_LENGTH(0x01) ASSERT_EQ()
    __EVENT_HASH(LogTopic12) TOPIC(0x01, 0x00) ASSERT_EQ_BYTES32()
    0x02 TOPIC(0x01, 0x01) ASSERT_EQ_BYTES32()
    0x03 TOPIC(0x01, 0x02) ASSERT_EQ_BYTES32()
    ASSERT_DATA_LENGTH(0x01, 0x14)
    SEED_20() DATA_WORD(0x01, 0x00) ASSERT_EQ_BYTES32()
    [EMITTER] EMITTER_OF(0x01) ASSERT_EQ_ADDRESS()

    0x04 TOPICS_LENGTH(0x02) ASSERT_EQ()
    __EVENT_HASH(LogTopic123) TOPIC(0x02, 0x00) ASSERT_EQ_BYTES32()
    0x04 TOPIC(0x02, 0x01) ASSERT_EQ_BYTES32()
    0x05 TOPIC(0x02, 0x02) ASSERT_EQ_BYTES32()
    0x06 TOPIC(0x02, 0x03) ASSERT_EQ_BYTES32()
    ASSERT_DATA_LENGTH(0x02, 0x18)
    SEED_24() DATA_WORD(0x02, 0x00) ASSERT_EQ_BYTES32()
    // assertEq(entries[2].emitter, emitter2.getEmitterAddr())
    __FUNC_SIG("getEmitterAddr()") [EMITTER_V2] STATICCALL_FUNCTION(0x00)
    EMITTER_OF(0x02) ASSERT_EQ_ADDRESS()
}

#define test RECORDED_LOGS_JSON_EMPTY() = {
    VM_RECORD_LOGS(0x00)
    VM_GET_RECORDED_LOGS_JSON(0x00) pop

    // assertEq(logsJson, "[]")
    0x02 0x20 mload ASSERT_EQ()
    __RIGHTPAD(__BYTES("[]")) 0x40 mload ASSERT_EQ_BYTES32()
}

#[etch(0x2000, "")]
#define test RECORDS_CONSUMED_AS_READ() = {
    // emitter.emitEvent(1, generateTestData(16))
    SEED_16() 0x10 0x40 0x01
    __FUNC_SIG("emitEvent(uint256,bytes)") [EMITTER] CALL_FUNCTION(0x04) ASSERT_TRUE()

    // hit record now
    VM_RECORD_LOGS(0x00)

    VM_GET_RECORDED_LOGS(0x00) pop
    0x00 0x20 mload ASSERT_EQ()

    // emit after calling .getRecordedLogs(): emitter.emitEvent(2, 3, generateTestData(24))
    SEED_24() 0x18 0x60 0x03 0x02
    __FUNC_SIG("emitEvent(uint256,uint256,bytes)") [EMITTER] CALL_FUNCTION(0x05) ASSERT_TRUE()

    VM_GET_RECORDED_LOGS(0x00) pop
    0x01 0x20 mload ASSERT_EQ()
    0x03 TOPICS_LENGTH(0x00) ASSERT_EQ()
    [EMITTER] EMITTER_OF(0x00) ASSERT_EQ_ADDRESS()

    // let's emit two more! emitter.emitEvent(4, 5, 6, generateTestData(20)) and
    // emitter.emitEvent(generateTestData(32)); only a call that reaches 32 bytes moves on to the next seed
    SEED_20() 0x14 0x80 0x06 0x05 0x04
    __FUNC_SIG("emitEvent(uint256,uint256,uint256,bytes)") [EMITTER] CALL_FUNCTION(0x06) ASSERT_TRUE()
    SEED() 0x20 0x20
    __FUNC_SIG("emitEvent(bytes)") [EMITTER] CALL_FUNCTION(0x03) ASSERT_TRUE()

    VM_GET_RECORDED_LOGS(0x00) pop
    0x02 0x20 mload ASSERT_EQ()
    0x04 TOPICS_LENGTH(0x00) ASSERT_EQ()
    0x01 TOPICS_LENGTH(0x01) ASSERT_EQ()
    [EMITTER] EMITTER_OF(0x00) ASSERT_EQ_ADDRESS()
    [EMITTER] EMITTER_OF(0x01) ASSERT_EQ_ADDRESS()

    // the last one: emitter.emitEvent(7, 8, 9, generateTestData(24))
    SEED2_24() 0x18 0x80 0x09 0x08 0x07
    __FUNC_SIG("emitEvent(uint256,uint256,uint256,bytes)") [EMITTER] CALL_FUNCTION(0x06) ASSERT_TRUE()

    VM_GET_RECORDED_LOGS(0x00) pop
    0x01 0x20 mload ASSERT_EQ()
    0x04 TOPICS_LENGTH(0x00) ASSERT_EQ()
    [EMITTER] EMITTER_OF(0x00) ASSERT_EQ_ADDRESS()
}
