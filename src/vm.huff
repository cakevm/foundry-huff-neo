/// Only allows memory writes to offsets [0x00, 0x60) ∪ [min, max) in the next created subcontext.
/// If any other memory is written to, the test will fail. Can be called multiple times to add more ranges
/// to the set.
/// Consumes uint64, uint64 from the stack: vm.expectSafeMemoryCall(uint64,uint64)
/// Overwrites 0x44 bytes of memory from memoryOffset.
#define macro VM_EXPECT_SAFE_MEMORY_CALL(memoryOffset) = takes(2) returns(0) {
    __RIGHTPAD(__FUNC_SIG('expectSafeMemoryCall(uint64,uint64)'))
    CALL_VM(0x2, 0x00, <memoryOffset>)
}

/// Expects a TIP-20 `LogoURIUpdated(address indexed updater, string newLogoURI)` event.
/// Consumes `elements` ABI-encoded words of address, address, string from the stack: vm.expectTip20LogoURIUpdated(address,address,string)
/// Overwrites the calldata and the return data in memory from memoryOffset.
#define macro VM_EXPECT_TIP20_LOGO_URIUPDATED(elements, memoryOffset) = takes(0) returns(0) {
    __RIGHTPAD(__FUNC_SIG('expectTip20LogoURIUpdated(address,address,string)'))
    CALL_VM(<elements>, 0x00, <memoryOffset>)
}

/// Marks a test as skipped. Must be called at the top level of a test.
/// Consumes bool from the stack: vm.skip(bool)
/// Overwrites 0x24 bytes of memory from memoryOffset.
#define macro VM_SKIP(memoryOffset) = takes(1) returns(0) {
    __RIGHTPAD(__FUNC_SIG('skip(bool)'))
    CALL_VM(0x1, 0x00, <memoryOffset>)
}

/// Marks a test as skipped with a reason. Must be called at the top level of a test.
/// Consumes `elements` ABI-encoded words of bool, string from the stack: vm.skip(bool,string)
/// Overwrites the calldata and the return data in memory from memoryOffset.
#define macro VM_SKIP_BOOL_STRING(elements, memoryOffset) = takes(0) returns(0) {
    __RIGHTPAD(__FUNC_SIG('skip(bool,string)'))
    CALL_VM(<elements>, 0x00, <memoryOffset>)
}

/// Stops all safe memory expectation in the current subcontext.
/// Consumes nothing from the stack: vm.stopExpectSafeMemory()
/// Overwrites 0x4 bytes of memory from memoryOffset.
#define macro VM_STOP_EXPECT_SAFE_MEMORY(memoryOffset) = takes(0) returns(0) {
    __RIGHTPAD(__FUNC_SIG('stopExpectSafeMemory()'))
    CALL_VM(0x0, 0x00, <memoryOffset>)
}

/// Utility cheatcode to copy storage of `from` contract to another `to` contract.
/// Consumes address, address from the stack: vm.copyStorage(address,address)
/// Overwrites 0x44 bytes of memory from memoryOffset.
#define macro VM_COPY_STORAGE(memoryOffset) = takes(2) returns(0) {
    __RIGHTPAD(__FUNC_SIG('copyStorage(address,address)'))
    CALL_VM(0x2, 0x00, <memoryOffset>)
}

/// Causes the next contract creation (via new) to fail and return its initcode in the returndata buffer.
/// This allows type-safe access to the initcode payload that would be used for contract creation.
/// Example usage:
/// vm.interceptInitcode();
/// bytes memory initcode;
/// try new MyContract(param1, param2) { assert(false); }
/// catch (bytes memory interceptedInitcode) { initcode = interceptedInitcode; }
/// Consumes nothing from the stack: vm.interceptInitcode()
/// Overwrites 0x4 bytes of memory from memoryOffset.
#define macro VM_INTERCEPT_INITCODE(memoryOffset) = takes(0) returns(0) {
    __RIGHTPAD(__FUNC_SIG('interceptInitcode()'))
    CALL_VM(0x0, 0x00, <memoryOffset>)
}

/// Utility cheatcode to set arbitrary storage for given target address.
/// Consumes address from the stack: vm.setArbitraryStorage(address)
/// Overwrites 0x24 bytes of memory from memoryOffset.
#define macro VM_SET_ARBITRARY_STORAGE_ADDRESS(memoryOffset) = takes(1) returns(0) {
    __RIGHTPAD(__FUNC_SIG('setArbitraryStorage(address)'))
    CALL_VM(0x1, 0x00, <memoryOffset>)
}

/// Utility cheatcode to set arbitrary storage for given target address and overwrite
/// any storage slots that have been previously set.
/// Consumes address, bool from the stack: vm.setArbitraryStorage(address,bool)
/// Overwrites 0x44 bytes of memory from memoryOffset.
#define macro VM_SET_ARBITRARY_STORAGE_ADDRESS_BOOL(memoryOffset) = takes(2) returns(0) {
    __RIGHTPAD(__FUNC_SIG('setArbitraryStorage(address,bool)'))
    CALL_VM(0x2, 0x00, <memoryOffset>)
}
